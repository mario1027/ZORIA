include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include requirements.txt
include requirements-dev.txt

# Datos del paquete (assets estáticos y configuración) — necesarios para que
# la app funcione instalada con pip desde cualquier directorio de trabajo.
graft zoria/assets
graft zoria/config
include zoria/hw_timing_profile.json

exclude *.pyc
exclude .DS_Store
exclude .gitignore

global-exclude __pycache__
global-exclude *.py[cod]
